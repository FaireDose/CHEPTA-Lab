{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "groups",
    "blocks",
    "evidence",
    "decisions",
    "runs",
    "tasks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "qualifier": {
          "enum": [
            "equal",
            "less_than",
            "greater_than",
            "lower_bound",
            "upper_bound",
            "approximate"
          ]
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "basis",
        "qualifier"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_hash_kind": {
          "enum": [
            "archived_html",
            "archived_pdf",
            "archived_text"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "source_fragment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extraction_method": {
          "type": "string",
          "minLength": 1
        },
        "collected_on": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "target_revealing": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_id",
        "source_url",
        "source_version",
        "document_sha256",
        "document_hash_kind",
        "locator",
        "selector",
        "source_fragment_sha256",
        "extraction_method",
        "collected_on",
        "summary",
        "target_revealing"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "author_reported_simulation",
            "author_process_description",
            "measurement",
            "lab_inference"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "quantities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "legacy_origin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "block_ids",
        "claim",
        "classification",
        "conditions",
        "quantities",
        "limits",
        "legacy_origin"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "obstacle": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "expected_change": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verification_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "rationale_classification": {
          "enum": [
            "author_stated",
            "lab_inference",
            "mixed_explicitly_separated"
          ]
        },
        "legacy_origin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "evidence_ids",
        "obstacle",
        "mechanism",
        "operation",
        "expected_change",
        "alternatives",
        "limits",
        "verification_required",
        "rationale_classification",
        "legacy_origin"
      ],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "request": {
          "$ref": "#/$defs/artifact"
        },
        "response": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "id",
        "tool",
        "request",
        "response"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "engine_commit_requested": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "engine_commit_observed": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_note": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "enum": [
            "reconstructed_from_execution_artifacts"
          ]
        },
        "tool_contract": {
          "$ref": "#/$defs/artifact"
        },
        "manifest": {
          "$ref": "#/$defs/artifact"
        },
        "runner": {
          "$ref": "#/$defs/artifact"
        },
        "verification": {
          "$ref": "#/$defs/artifact"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "family",
        "source_ids",
        "engine_commit_requested",
        "engine_commit_observed",
        "revision_note",
        "representation",
        "tool_contract",
        "manifest",
        "runner",
        "verification",
        "execution_id",
        "calls",
        "limitations"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "source_accuracy",
            "engineering",
            "rights",
            "context"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_type": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "decision": {
          "enum": [
            "approved",
            "changes_requested"
          ]
        },
        "review_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope",
        "reviewer",
        "reviewer_type",
        "decision",
        "review_digest",
        "date",
        "notes"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "quantities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "request_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "prompt",
        "evidence_ids",
        "state",
        "goals",
        "constraints",
        "quantities",
        "basis",
        "missing_information",
        "request_artifact"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "answer",
        "rubric",
        "evidence_ids",
        "decision_ids",
        "run_ids"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "accepted"
          ]
        },
        "task_type": {
          "enum": [
            "explain",
            "select_next",
            "tool_use"
          ]
        },
        "claim_scope": {
          "enum": [
            "literature_reasoning",
            "numerical_benchmark",
            "process_performance"
          ]
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "split_group": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "revision",
        "status",
        "task_type",
        "claim_scope",
        "family",
        "split_group",
        "source_ids",
        "input",
        "target",
        "reviews",
        "blockers"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "split": {
          "enum": [
            "unassigned",
            "train",
            "development",
            "test"
          ]
        }
      },
      "required": [
        "id",
        "family",
        "source_ids",
        "split"
      ],
      "additionalProperties": false
    }
  },
  "title": "CHEPTA-Lab canonical training corpus v1"
}
